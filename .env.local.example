# ── Base de datos (OBLIGATORIA) ───────────────────────────────────────────────
# En producción es el PostgreSQL local del servidor.
DATABASE_URL=postgresql://usuario:clave@localhost:5432/temi_edulab
DATABASE_SSL=false

# ── Sesión del docente (OBLIGATORIA) ──────────────────────────────────────────
# Sin este valor el servidor no arranca.
# Generar con: node -p "require('crypto').randomBytes(32).toString('hex')"
JWT_SECRET=reemplazar-con-64-caracteres-hex-aleatorios

# ── Correo de aviso al registrar un docente ───────────────────────────────────
# Cuenta de Gmail con contraseña de aplicación.
GMAIL_USER=cuenta@gmail.com
GMAIL_APP_PASSWORD=contrasena-de-aplicacion

# ── Supabase ──────────────────────────────────────────────────────────────────
# No es la base de datos. Solo lo usa el cliente supabase-js (login con Google,
# desactivado), pero el cliente se crea al cargar la app y necesita estos valores.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# ── Opcionales / en desuso ────────────────────────────────────────────────────
# Login con Google (desactivado).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Conexión HTTP directa al robot (reemplazada por WebSocket).
NEXT_PUBLIC_ROBOT_API_URL=
# Puerto del servidor (por defecto 3000).
# PORT=3000
