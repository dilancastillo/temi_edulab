NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_ROBOT_API_URL=http://192.168.10.64:8765
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/temi_edulab
DATABASE_SSL=false

# JWT session secret — REQUIRED.
# Generate with: node -p "require('crypto').randomBytes(32).toString('hex')"
# Must be set for teacher sessions to work. Missing value causes a startup error.
JWT_SECRET=replace-with-64-hex-chars-random-secret
